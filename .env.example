# Copy to .env for local Docker Compose use. Never commit real secrets.

# Published host addresses and ports
API_HOST=0.0.0.0
API_PORT=8000
API_CONTAINER_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=maintain_db
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
APP_DB_USER=maintain_app
APP_DB_PASSWORD=replace-with-a-long-random-app-password

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Service URLs. API_BASE_URL is for host/public clients; the internal URL is for Compose workers.
API_BASE_URL=http://localhost:8000/api/v1
API_INTERNAL_BASE_URL=http://web_api:8000/api/v1
DATABASE_URL=postgresql://maintain_app:replace-with-a-long-random-app-password@postgres_db:5432/maintain_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Required secrets. Generate unique values outside source control.
AUTH_SECRET=replace-with-a-long-random-auth-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token