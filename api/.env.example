# Local development configuration; export these for a direct API run.
DATABASE_URL=postgresql://admin:secret@localhost:5432/maintain_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
AUTH_SECRET=replace-with-a-random-signing-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-shared-service-token
# Celery/ETL uses an API base including /api/v1.
API_BASE_URL=http://localhost:8000/api/v1
